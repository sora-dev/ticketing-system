# RBI iTrack Frontend Environment Configuration
# Copy this file to .env and update the values according to your setup

# API Configuration
# Backend API base URL - update this if your backend runs on a different host/port
# For development: http://localhost:5001
# For production: https://your-backend-domain.com
REACT_APP_API_URL=http://localhost:5001

# Environment
# Set to 'production' in production environment
NODE_ENV=development