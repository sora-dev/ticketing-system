# RBI iTrack Backend Environment Configuration
# Copy this file to .env and update the values according to your setup

# Database Configuration
# MongoDB connection string - update with your database credentials if using MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/ticketing-system

# JWT Configuration
# Generate a strong secret key for JWT token signing (use a random string generator)
# IMPORTANT: Change this in production!
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Server Configuration
# Port number for the backend server
PORT=5001
# Host address (0.0.0.0 allows access from other machines on the network)
HOST=0.0.0.0

# Default Admin Credentials (for seeding initial admin user)
# These credentials will be used when running the seed script
DEFAULT_ADMIN_EMAIL=admin@rbi-itrack.com
DEFAULT_ADMIN_PASSWORD=admin123

# Environment
# Set to 'production' in production environment
NODE_ENV=development